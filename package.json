{
  "name": "relayir",
  "version": "0.4.0",
  "description": "A compact, auditable handoff protocol and benchmark for AI agents.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Nicolas Del Rosario",
    "url": "https://github.com/nicolasdelrosario"
  },
  "homepage": "https://github.com/nicolasdelrosario/relayir#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasdelrosario/relayir.git"
  },
  "bugs": {
    "url": "https://github.com/nicolasdelrosario/relayir/issues"
  },
  "keywords": ["ai-agents", "opencode", "multi-agent", "protocol", "benchmark", "token-efficiency"],
  "engines": { "node": ">=24", "opencode": ">=1.18.18 <2" },
  "exports": {
    ".": "./dist/protocol.js",
    "./server": "./dist/plugin.js"
  },
  "files": ["dist", "src/plugin.ts", "src/protocol.ts", "src/benchmark.ts", "src/report.ts", "src/agentic-benchmark.ts", "src/agentic-report.ts", ".opencode/agents", ".opencode/plugins/relayir-agentic-contract.ts", "assets", "contracts", "fixtures", "scripts", "docs", "benchmarks/results", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts",
    "benchmark:fake": "node scripts/fake-benchmark.ts",
    "benchmark:smoke": "node scripts/benchmark.ts --split smoke",
    "benchmark": "node scripts/benchmark.ts",
    "benchmark:compact": "node scripts/compact-results.ts",
    "benchmark:report": "node scripts/report.ts",
    "agentic:benchmark": "node scripts/agentic-benchmark.ts",
    "agentic:report": "node scripts/agentic-report.ts"
  }
}
